    {
      "cell_type": "code",
      "execution_count": 39,
      "metadata": {
        "id": "ZcusyqTwD9HN"
      },
      "outputs": [],
      "source": [
        "kf = KFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
        "\n",
        "muestra = np.random.RandomState(RANDOM_STATE).choice(\n",
        "    len(X_train), size=5000, replace=False\n",
        ")\n",
        "\n",
        "X_busqueda = X_train.iloc[muestra].reset_index(drop=True)\n",
        "y_busqueda = y_train.iloc[muestra].reset_index(drop=True)\n",
        "\n",
        "def cv_mae(modelo, X, y):\n",
        "    errores = []\n",
        "\n",
        "    for train_idx, val_idx in kf.split(X):\n",
        "        Xtr = X.iloc[train_idx]\n",
        "        Xval = X.iloc[val_idx]\n",
        "        ytr = y.iloc[train_idx]\n",
        "        yval = y.iloc[val_idx]\n",
        "\n",
        "        modelo.fit(Xtr, ytr)\n",
        "        pred = modelo.predict(Xval)\n",
        "        errores.append(mean_absolute_error(yval, pred))\n",
        "\n",
        "    return np.mean(errores)"
      ],
      "id": "ZcusyqTwD9HN"
