        "modelos_base = {\n",
        "    \"Regresión Lineal\": LinearRegression(),\n",
        "    \"Ridge\": Ridge(alpha=10),\n",
        "    \"KNN\": KNeighborsRegressor(n_neighbors=15, weights=\"distance\"),\n",
        "    \"Árbol de Decisión\": DecisionTreeRegressor(\n",
        "        max_depth=18,\n",
        "        min_samples_leaf=10,\n",
        "        random_state=RANDOM_STATE\n",
        "    ),\n",
        "    \"Random Forest\": RandomForestRegressor(\n",
        "        n_estimators=50,\n",
        "        max_features=\"sqrt\",\n",
        "        random_state=RANDOM_STATE,\n",
        "        n_jobs=-1\n",
        "    )\n",
        "}\n",
        "\n",
        "def evaluar(modelo, Xtr, ytr, Xval, yval):\n",
        "    modelo.fit(Xtr, ytr)\n",
        "    pred = modelo.predict(Xval)\n",
        "    mae = mean_absolute_error(yval, pred)\n",
        "    rmse = np.sqrt(mean_squared_error(yval, pred))\n",
        "    r2 = r2_score(yval, pred)\n",
        "    return mae, rmse, r2\n",
        "\n",
        "base = []\n",
        "\n",
        "for nombre, modelo in modelos_base.items():\n",
        "    mae, rmse, r2 = evaluar(modelo, X_train, y_train, X_test, y_test)\n",
        "    base.append([nombre, mae, rmse, r2])\n",
        "\n",
        "base_df = pd.DataFrame(base, columns=[\"Modelo\", \"MAE\", \"RMSE\", \"R2\"])\n",
        "base_df.sort_values(\"MAE\")"
