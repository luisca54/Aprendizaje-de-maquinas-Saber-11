        "def errores_fold(modelo, X, y):\n",
        "    errores = []\n",
        "\n",
        "    for train_idx, val_idx in kf.split(X):\n",
        "        Xtr = X.iloc[train_idx]\n",
        "        Xval = X.iloc[val_idx]\n",
        "        ytr = y.iloc[train_idx]\n",
        "        yval = y.iloc[val_idx]\n",
        "\n",
        "        modelo.fit(Xtr, ytr)\n",
        "        pred = modelo.predict(Xval)\n",
        "\n",
        "        errores.append(mean_absolute_error(yval, pred))\n",
        "\n",
        "    return errores\n",
        "\n",
        "errores_ridge = errores_fold(modelo_ridge, X_train, y_train)\n",
        "\n",
        "# Voting manual\n",
        "errores_voting = []\n",
        "\n",
        "for train_idx, val_idx in kf.split(X_train):\n",
